{
  "name": "obsidian-github-sync",
  "version": "1.0.0",
  "description": "Headless cross-platform GitHub sync for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "*0.28.2",
    "obsidian": "*1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
