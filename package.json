{
  "name": "obsidian-github-sync",
  "version": "1.0.0",
  "description": "Headless cross-platform GitHub sync for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.17",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "esbuild": "0.25.5"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
